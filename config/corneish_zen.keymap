#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define AERO 1
#define NAV 2
#define NUM 3
#define SYM 4
#define MEDIA 5
#define SYSTEM 6

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
        // zmk,physical-layout = &foostan_corne_5col_layout;
    };
};

/ {
    behaviors {
        bhm: balanced_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        bhs: balanced_homerow_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        fth: fast_thumb_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "FAST_THUMB_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        th: thumb_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        sth: system_thumb_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "SYSTEM_THUMB_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <320>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";


        default_layer {
            display-name = "ANDRW";
// --------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// |  ESC |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ENT  |
//                    | DEL | ESC | BSPC|   | SPC | TAB | RET |
            bindings = <
&kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
&kp ESC   &bhs LSHFT A &bhm LCTRL S &bhm LALT D &bhm LGUI F &kp G   &kp H &bhm LGUI J  &bhm RALT K     &bhm RCTRL L   &bhs RSHFT SEMI &kp SQT
&kp LCTRL &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RET
               &th MEDIA DEL &fth NUM ESC &th NAV BSPC  &th RGUI SPACE &fth SYM TAB &sth SYSTEM RET
            >;
        };

        nav_layer {
            display-name = "NAV";
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |LineS| PgDn| PgUp|LineE|     |      |
// |      |     |     |     |     |     |   |Left |Down | Up  |Right|     |      |
// |      |     |     |     |     |     |   |WordL|     |     |WordR|     |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
&trans &trans &trans &trans &trans &trans   &kp LG(LEFT)  &kp PG_DN &kp PG_UP &kp LG(RIGHT) &trans &trans
&trans &trans &trans &trans &trans &trans   &kp LEFT      &kp DOWN  &kp UP    &kp RIGHT     &trans &trans
&trans &trans &trans &trans &trans &trans   &kp LA(LEFT)  &trans    &trans    &kp LA(RIGHT) &trans &trans
                              &trans &trans &trans        &trans    &trans    &trans
            >;
        };

        num_layer {
            display-name = "NUM";
// -----------------------------------------------------------------------------------------
// |      |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |      |
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
&trans &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans  &trans &trans &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
// -----------------------------------------------------------------------------------------
// |      |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |      |
// |      |     |     |     |     |  \  |   |  -  |  =  |  '  |  [  |  ]  |      |
// |      |     |     |  ~  |  `  |  |  |   |  _  |  +  |  "  |  {  |  }  |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
&trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &trans
&trans &trans   &trans &trans   &trans   &kp BSLH    &kp MINUS &kp EQUAL &kp SQT   &kp LBKT &kp RBKT &trans
&trans &trans   &trans &kp TILDE &kp GRAVE &kp PIPE   &kp UNDER &kp PLUS  &kp DQT   &kp LBRC &kp RBRC &trans
                          &trans &trans &trans       &trans    &trans    &trans
            >;
        };

        media_layer {
            display-name = "MEDIA";
// -----------------------------------------------------------------------------------------
// |      |     |Prev |Play |Next |     |   |     |     |     |     |     |      |
// |      |     |Vol- |Mute |Vol+ |     |   |     |     |     |     |     |      |
// |      |     |Bri- |     |Bri+ |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
&trans &trans &kp C_PREV   &kp C_PP   &kp C_NEXT   &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &kp C_BRI_DN &trans     &kp C_BRI_UP &trans   &trans &trans &trans &trans &trans &trans
                                  &trans &trans &trans      &trans &trans &trans
            >;
        };

        system_layer {
            display-name = "SYSTEM";
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
// |      | BT1 | BT2 | BT3 | BT4 | BT5 |   |BTCLR|     |     |     |     |Studio|
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
&trans &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans
&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR   &trans &trans &trans &trans &studio_unlock
&trans &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans
                                         &trans &trans &trans           &trans       &trans &trans
            >;
        };
    };
};
